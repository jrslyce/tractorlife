{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tractorlife",
  "main": "./worker.js",
  "account_id": "4187a4960bcb1a400ff9c7788e5a0ca5",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./game",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SAVES", "class_name": "NameGameSaves" },
      { "name": "FARMERS", "class_name": "NameFarmerList" },
      { "name": "SHARED_WORLD", "class_name": "SharedWorld" },
      { "name": "REALTIME", "class_name": "RealtimeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameSaves"] },
    { "tag": "v2", "new_sqlite_classes": ["FarmerList"] },
    { "tag": "v3", "new_sqlite_classes": ["SharedWorld"] },
    { "tag": "v4", "new_sqlite_classes": ["RealtimeRoom"] },
    {
      "tag": "v5-name-farm-reset",
      "deleted_classes": ["GameSaves", "FarmerList"],
      "new_sqlite_classes": ["NameGameSaves", "NameFarmerList"]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "SAVES", "class_name": "NameGameSaves" },
        { "name": "FARMERS", "class_name": "NameFarmerList" },
        { "name": "SHARED_WORLD", "class_name": "SharedWorld" },
        { "name": "REALTIME", "class_name": "RealtimeRoom" }
      ]
    }
  }
}
